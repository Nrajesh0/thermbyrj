<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Explicit allowlist: vault_registry_prefs.xml, vault_secure_prefs.xml, and encrypted vault files are intentionally excluded -->
    <cloud-backup>
        <include domain="sharedpref" path="thermal_prefs.xml"/>
        <include domain="sharedpref" path="guard_events_prefs.xml"/>
        <include domain="sharedpref" path="file_bookmarks_prefs.xml"/>
        <include domain="sharedpref" path="privacy_diff_prefs.xml"/>
        <include domain="file" path="dot_settings_mirror.json"/>
        <include domain="database" path="thermal_database"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="thermal_prefs.xml"/>
        <include domain="sharedpref" path="guard_events_prefs.xml"/>
        <include domain="sharedpref" path="file_bookmarks_prefs.xml"/>
        <include domain="sharedpref" path="privacy_diff_prefs.xml"/>
        <include domain="file" path="dot_settings_mirror.json"/>
        <include domain="database" path="thermal_database"/>
    </device-transfer>
</data-extraction-rules>
